PORT=8787
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:8787
FRONTEND_ORIGIN=http://127.0.0.1:8765

# Supabase — pakai service role HANYA di server, jangan pernah ke browser
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

STORAGE_BUCKET=kenangan
BACKUP_BUCKET=kenangan-cadangan
SIGNED_URL_TTL_SECONDS=3600
SHARE_TTL_HOURS=48

# Ukuran unggah maksimal (byte) — 20 MB
MAX_UPLOAD_BYTES=20971520
